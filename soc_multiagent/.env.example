# API Keys (obligatorias)
OPENAI_API_KEY=tu-openai-api-key
TAVILY_API_KEY=tu-tavily-api-key
VIRUSTOTAL_API_KEY=tu-virustotal-api-key

# Gmail Configuration (opcional - necesario para notificaciones por email)
# Si el valor es solo un nombre de archivo (ej: credentials.json), se resuelve relativo al proyecto.
# Si es una ruta absoluta, se usa tal cual.
GOOGLE_APPLICATION_CREDENTIALS=credentials.json
GMAIL_TOKEN=token.json

# SOC Email Configuration
SOC_EMAIL_RECIPIENT=tu-email@ejemplo.com
SOC_EMAIL_SENDER=tu-email@ejemplo.com
